<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.tyla.tyla_media_player.MainController"
           styleClass="root-pane">

   <BorderPane styleClass="main-border">

      <top>
         <HBox styleClass="title-bar" alignment="CENTER_LEFT" spacing="6">
            <padding><Insets top="4" right="6" bottom="4" left="6"/></padding>
            <Label text="TYLA MEDIA PLAYER" styleClass="title-bar-label" HBox.hgrow="ALWAYS"/>
            <Button fx:id="menuButton" text="☰" styleClass="title-bar-btn" onAction="#toggleMenu"/>
         </HBox>
      </top>

      <left>
         <VBox fx:id="sidebar" styleClass="sidebar" spacing="2">
            <padding><Insets top="8" right="4" bottom="8" left="4"/></padding>

            <!-- add buttons for navigation -->

            <Label text="NAVIGATE" styleClass="sidebar-section-label"/>

            <Button text="⌂  HOME"
                    maxWidth="Infinity"
                    styleClass="sidebar-btn"
                    onAction="#showHome"/>

            <Button text="♪  AUDIO"
                    maxWidth="Infinity"
                    styleClass="sidebar-btn"
                    onAction="#showLibrary"/>

            <Button text="▶  VIDEO"
                    maxWidth="Infinity"
                    styleClass="sidebar-btn"
                    onAction="#showVideoLibrary"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Label text="TOOLS" styleClass="sidebar-section-label"/>

            <Button text="⚙  SETTINGS"
                    maxWidth="Infinity"
                    styleClass="sidebar-btn"
                    onAction="#toggleSettings"/>
         </VBox>
      </left>

      <center>
         <StackPane fx:id="mediaPane" styleClass="content-pane">
            <AnchorPane fx:id="contentArea">
               <VBox fx:id="homeView"
                     styleClass="home-view"
                     alignment="CENTER"
                     spacing="18"
                     AnchorPane.topAnchor="0"
                     AnchorPane.bottomAnchor="0"
                     AnchorPane.leftAnchor="0"
                     AnchorPane.rightAnchor="0">
                  <Label text="TYLA" styleClass="home-logo"/>
                  <Label text="MEDIA PLAYER" styleClass="home-subtitle"/>
                  <HBox spacing="12" alignment="CENTER">
                     <Button text="▶  VIDEO LIBRARY" styleClass="home-btn-primary" onAction="#showVideoLibrary"/>
                     <Button text="♪  AUDIO LIBRARY" styleClass="home-btn-secondary" onAction="#showLibrary"/>
                  </HBox>
               </VBox>
            </AnchorPane>
         </StackPane>
      </center>

      <bottom>
         <VBox>
            <!-- audio play bar -->
            <HBox fx:id="playerBar" styleClass="status-bar" alignment="CENTER_LEFT" spacing="10"
                  visible="false" managed="false">
               <padding><Insets top="4" right="8" bottom="10" left="4"/></padding>
               <Button fx:id="btnPlayPause" text="▶"
                       styleClass="transport-btn"
                       onAction="#togglePlayPause"/>
               <Button text="⏹" styleClass="transport-btn" onAction="#stopAudio"/>
               <Label fx:id="lblNowPlaying" text="NO TRACK" styleClass="status-label"/>
               <Slider fx:id="audioSeekBar" HBox.hgrow="ALWAYS"/>
               <Label fx:id="lblAudioTime" text="0:00 / 0:00" styleClass="status-label"/>
            </HBox>
         </VBox>
      </bottom>

   </BorderPane>
</StackPane>