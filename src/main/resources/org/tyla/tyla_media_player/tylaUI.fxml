<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tyla.tyla_media_player.MainController">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="813.0">
         <left>
            <VBox fx:id="sidebar" prefHeight="400.0" prefWidth="100.0" style="-fx-background-color: #424549;" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="homeButton" maxWidth="Infinity" mnemonicParsing="false" prefHeight="148.0" style="-fx-background-color: transparent;" text="home" textFill="WHITE" />
                  <Button fx:id="libraryButton" maxWidth="Infinity" mnemonicParsing="false" prefHeight="142.0" style="-fx-background-color: transparent;" text="library" textFill="WHITE" />
                  <Button fx:id="settingsButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#toggleSettings" prefHeight="152.0" style="-fx-background-color: transparent;" text="settings" textFill="WHITE" />
               </children>
            </VBox>
         </left>
         <center>
            <StackPane fx:id="mediaPane" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <children>
                  <AnchorPane fx:id="contentArea" prefHeight="200.0" prefWidth="200.0" />
               </children></StackPane>
         </center>
      </BorderPane>
      <Button fx:id="menuButton" mnemonicParsing="false" onAction="#toggleMenu" prefHeight="25.0" prefWidth="36.0" style="-fx-background-color: transparent;" text="☰" textFill="WHITE" StackPane.alignment="TOP_LEFT">
         <StackPane.margin>
            <Insets />
         </StackPane.margin>
      </Button>
   </children>
</StackPane>
