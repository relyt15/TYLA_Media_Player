<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.tyla.tyla_media_player.VideoLibraryController"
      styleClass="library-root"
      spacing="0">

    <!-- header -->
    <HBox styleClass="library-header" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
        <Label text="▶ VIDEO LIBRARY" styleClass="library-title"/>
        <VBox HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblVideoCount" text="0 VIDEOS" styleClass="library-count"/>
    </HBox>

    <!-- toolbar (add folder) -->
    <HBox styleClass="library-toolbar" alignment="CENTER_LEFT" spacing="6">
        <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
        <Button fx:id="btnAddDir"
                text="+ ADD DIR"
                onAction="#btnAddDirOnClick"
                styleClass="lib-btn"/>
    </HBox>

    <!-- column headers, aligns with metadata  -->
    <GridPane styleClass="library-col-header" hgap="5">
        <padding><Insets top="3" right="10" bottom="3" left="10"/></padding>

        <columnConstraints>
        <ColumnConstraints prefWidth="28" minWidth="28" maxWidth="28"/>
        <ColumnConstraints hgrow="ALWAYS" minWidth="60"/>
        <ColumnConstraints prefWidth="140" minWidth="140" maxWidth="140"/>
        <ColumnConstraints prefWidth="130" minWidth="130" maxWidth="130"/>
        <ColumnConstraints prefWidth="50" minWidth="50" maxWidth="50"/>
    </columnConstraints>

    <Label text="#"      styleClass="col-hdr" GridPane.columnIndex="0"/>
    <Label text="TITLE"  styleClass="col-hdr" GridPane.columnIndex="1"/>
    <Label text="DURATION"   styleClass="col-hdr" GridPane.columnIndex="4"/>
    </GridPane>

    <!-- video list  -->
    <ListView fx:id="videoListView"
              styleClass="song-list"
              VBox.vgrow="ALWAYS"/>

    <!-- watched folders -->
    <VBox styleClass="dir-panel" spacing="4">
        <padding><Insets top="6" right="10" bottom="8" left="10"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="WATCHED FOLDERS" styleClass="dir-panel-title"/>
            <VBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRemoveDir"
                    text="− REMOVE"
                    onAction="#btnRemoveDirOnClick"
                    styleClass="lib-btn lib-btn-danger"/>
        </HBox>

        <ListView fx:id="dirListView"
                  styleClass="dir-list"
                  prefHeight="70"/>
    </VBox>

</VBox>
