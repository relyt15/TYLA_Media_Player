<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.tyla.tyla_media_player.TYLAMediaPlayerController"
      styleClass="player-root"
      spacing="0">

    <StackPane styleClass="video-panel" VBox.vgrow="ALWAYS">
        <ImageView fx:id="imageView"
                   preserveRatio="true"
                   StackPane.alignment="CENTER"/>
    </StackPane>

    <VBox styleClass="seek-panel" spacing="2">
        <padding><Insets top="6" right="10" bottom="4" left="10"/></padding>

        <Slider fx:id="scrlMediaPlayerSlider"
                styleClass="seek-slider"/>

        <HBox alignment="CENTER_LEFT" spacing="6">
            <Label fx:id="lblMediaTime" text="00:00 / 00:00"
                   styleClass="time-label"/>
        </HBox>
    </VBox>

    <HBox styleClass="transport-bar" alignment="CENTER" spacing="4">
        <padding><Insets top="8" right="12" bottom="10" left="12"/></padding>

        <Button fx:id="btnIncrementBackwards" text="|◀◀"
                styleClass="transport-btn"
                onAction="#btnIncrementBackwardOnClick"/>

        <Button fx:id="btnStart" text="▶"
                styleClass="transport-btn transport-btn-play"
                onAction="#btnStartOnClick"/>

        <Button fx:id="btnStop" text="⏸"
                styleClass="transport-btn"
                onAction="#btnStopOnClick"/>

        <Button fx:id="btnReset" text="⏹"
                styleClass="transport-btn"
                onAction="#btnResetOnClick"/>

        <Button fx:id="btnIncrementForward" text="▶▶|"
                styleClass="transport-btn"
                onAction="#btnIncrementForwardOnClick"/>

        <Rectangle width="1" height="28"/>

        <Label text="SKIP:" styleClass="skip-label"/>
        <TextField fx:id="txtIncrementValue"
                   text="10"
                   styleClass="skip-field"
                   prefWidth="42"/>

        <Label text="SEC" styleClass="skip-label"/>
    </HBox>

</VBox>