<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.tyla.tyla_media_player.LibraryController"
      styleClass="library-root"
      spacing="0">

    <!-- audio library header. -->
    <!-- i made this before i made the video library so pardon the name -->
    <HBox styleClass="library-header" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
        <Label text="♪ LIBRARY" styleClass="library-title"/>
        <VBox HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblLibrarySongCount" text="0 SONGS" styleClass="library-count"/>
    </HBox>

    <!-- search and add -->
    <HBox styleClass="library-toolbar" alignment="CENTER_LEFT" spacing="6">
        <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>

        <Label text="🔍" styleClass="search-icon"/>
        <TextField fx:id="txtSearch"
                   promptText="SEARCH LIBRARY..."
                   styleClass="search-field"
                   HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnAddDir"
                text="+ ADD DIR"
                onAction="#btnAddDirOnClick"
                styleClass="lib-btn"/>

        <Button fx:id="btnRescan"
                text="↻ RESCAN"
                onAction="#btnRescanOnClick"
                styleClass="lib-btn"/>

        <Button fx:id="btnClearLib"
                text="✕ CLEAR"
                onAction="#btnClearLibOnClick"
                styleClass="lib-btn lib-btn-danger"/>
    </HBox>

    <!-- column headers, align with metadata -->
    <GridPane styleClass="library-col-header" hgap="5">
        <padding><Insets top="3" right="10" bottom="3" left="10"/></padding>

        <columnConstraints>
            <ColumnConstraints prefWidth="28" minWidth="28" maxWidth="28"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="60"/>
            <ColumnConstraints prefWidth="140" minWidth="140" maxWidth="140"/>
            <ColumnConstraints prefWidth="130" minWidth="130" maxWidth="130"/>
            <ColumnConstraints prefWidth="50" minWidth="50" maxWidth="50"/>
        </columnConstraints>

        <Label text="#"      styleClass="col-hdr" GridPane.columnIndex="0"/>
        <Label text="TITLE"  styleClass="col-hdr" GridPane.columnIndex="1"/>
        <Label text="ARTIST" styleClass="col-hdr" GridPane.columnIndex="2"/>
        <Label text="ALBUM"  styleClass="col-hdr" GridPane.columnIndex="3"/>
        <Label text="DURATION"   styleClass="col-hdr" GridPane.columnIndex="4"/>
    </GridPane>

    <!-- playlist panel -->
    <VBox styleClass="dir-panel" spacing="4">
        <padding><Insets top="6" right="10" bottom="8" left="10"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="PLAYLISTS" styleClass="dir-panel-title"/>
            <VBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnNewPlaylist"
                    text="+ NEW"
                    onAction="#btnNewPlaylistOnClick"
                    styleClass="lib-btn"/>
            <Button fx:id="btnDeletePlaylist"
                    text="− DELETE"
                    onAction="#btnDeletePlaylistOnClick"
                    styleClass="lib-btn lib-btn-danger"/>
        </HBox>

        <!-- playlist names -->
        <ListView fx:id="playlistListView"
                  styleClass="dir-list"
                  prefHeight="80"/>

        <!-- songs in selected playlist -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="lblPlaylistSongCount" text="0 SONGS" styleClass="library-count"/>
            <VBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAddToPlaylist"
                    text="+ ADD SELECTED"
                    onAction="#btnAddToPlaylistOnClick"
                    styleClass="lib-btn"/>
            <Button fx:id="btnRemoveFromPlaylist"
                    text="− REMOVE"
                    onAction="#btnRemoveFromPlaylistOnClick"
                    styleClass="lib-btn lib-btn-danger"/>
        </HBox>

        <ListView fx:id="playlistSongView"
                  styleClass="dir-list"
                  prefHeight="100"/>
    </VBox>

    <!-- song list -->
    <ListView fx:id="songListView"
              styleClass="song-list"
              VBox.vgrow="ALWAYS"/>

    <!-- directory -->
    <VBox styleClass="dir-panel" spacing="4">
        <padding><Insets top="6" right="10" bottom="8" left="10"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="WATCHED FOLDERS" styleClass="dir-panel-title"/>
            <VBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRemoveDir"
                    text="− REMOVE"
                    onAction="#btnRemoveDirOnClick"
                    styleClass="lib-btn lib-btn-danger"/>
        </HBox>

        <ListView fx:id="dirListView"
                  styleClass="dir-list"
                  prefHeight="70"/>
    </VBox>

</VBox>